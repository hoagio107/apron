{
  "name": "apron-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "tauri:dev": "pnpm --filter desktop tauri dev",
    "tauri:build": "pnpm --filter desktop tauri build",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "build:desktop": "pnpm --filter desktop build",
    "build:mobile": "pnpm --filter mobile build",
    "build:apk": "pnpm build:mobile && cd apps/mobile && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @apron/core test"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "eslint": "^8.57.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.5",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "vite": ">=8.2.4",
      "prosemirror-view": ">=1.42.3"
    }
  }
}
